# Where account data comes from: `live` talks to SimpleFIN Bridge, `fixture` replays
# the committed files in `api/fixtures/` and never touches the network.
PENNILESS_SOURCE=live

# Directory holding the SQLite database and `credentials.json`. Defaults to `api/.data`.
PENNILESS_DATA_DIR=

# Full path to the SQLite file. Defaults to `api/.data/penniless.sqlite` in live mode and
# `api/.data/penniless-dev.sqlite` in fixture mode.
PENNILESS_DB_PATH=

# Directory of captured `/accounts` responses used when `PENNILESS_SOURCE=fixture`.
# Defaults to `api/fixtures`.
PENNILESS_FIXTURE_DIR=

# How long to refuse a manual refresh after a successful fetch.
PENNILESS_REFRESH_MIN_INTERVAL_HOURS=6
